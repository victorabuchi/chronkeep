# ChronKeep cloud server. Copy to .env for local use; on Render these are set in the dashboard (see render.yaml).

# Postgres 15+. On Supabase use the Session pooler string (port 5432, IPv4); the user name is postgres.<project-ref>.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chronkeep"

# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# The public address (no trailing slash). Used for sign-in redirects and emails.
APP_URL="http://localhost:3000"

# Password-reset emails. Without these, the link is printed in the server log.
RESEND_API_KEY=""
RESEND_FROM="ChronKeep <hello@example.com>"

# Sign in with Google: redirect URI <APP_URL>/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Sign in with Apple: return URL <APP_URL>/auth/apple/callback
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""
APPLE_APP_ID="com.victorabuchi.chronkeep"
